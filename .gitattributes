# Normalize all text files to LF in the repository
* text=auto eol=lf

# Explicitly binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.whl binary

# Explicit text rules
*.py text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.lock text eol=lf
Dockerfile text eol=lf
